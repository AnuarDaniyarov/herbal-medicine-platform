# Local database credentials for herbal-medicine-platform
#
# Application defaults (application.yaml):
#   DB_USERNAME=herbal_app
#   DB_PASSWORD=herbal_local_dev
#
# Override with environment variables if needed.
# Do not commit real production secrets.
DB_USERNAME=herbal_app
DB_PASSWORD=herbal_local_dev

# Optional: creates the first ADMIN account if this email does not exist yet.
# Use a unique, strong password of at least 12 characters.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FULL_NAME=Administrator
